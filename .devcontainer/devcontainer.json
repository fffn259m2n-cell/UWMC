{
  "name": "UWMC projects (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -e ./quality-signal-monitor[dev] -e ./ep-research-copilot[dev] -e ./teach-back-companion[dev]",
  "postAttachCommand": {
    "teach-back-demo": "cd teach-back-companion && teachback serve --host 0.0.0.0 --port 8000"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Teach-Back Companion demo", "onAutoForward": "openPreview"}
  },
  "customizations": {
    "vscode": {"extensions": ["ms-python.python"]}
  }
}
